<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        xmlns:fx="http://javafx.com/fxml"
        fx:controller="net.vinograd.generativeflowfield.presentation.Controller"
        prefWidth="1200"
        prefHeight="800">

    <center>
        <StackPane fx:id="canvasContainer">
            <Canvas fx:id="canvas"
                    width="950"
                    height="800"/>
        </StackPane>
    </center>

    <right>
        <VBox spacing="12"
              prefWidth="240"
              minWidth="240"
              style="-fx-padding: 20;
                     -fx-background-color: #202124;">

            <Label text="Flow Field"
                   style="-fx-text-fill: white;
                          -fx-font-size: 22px;
                          -fx-font-weight: bold;"/>

            <Label text="Particles"
                   style="-fx-text-fill: white;"/>

            <Slider fx:id="particleSlider"
                    min="100"
                    max="10000"
                    value="2000"
                    blockIncrement="100"/>

            <Label fx:id="particleValueLabel"
                   text="2000"
                   style="-fx-text-fill: #aaaaaa;"/>

            <Label text="Particle speed"
                   style="-fx-text-fill: white;"/>

            <Slider fx:id="speedSlider"
                    min="1"
                    max="300"
                    value="80"/>

            <Label text="Field scale"
                   style="-fx-text-fill: white;"/>

            <Slider fx:id="scaleSlider"
                    min="0.001"
                    max="0.05"
                    value="0.01"/>

            <Label text="Trail fade"
                   style="-fx-text-fill: white;"/>

            <Slider fx:id="fadeSlider"
                    min="0"
                    max="1"
                    value="0.05"/>

            <Label text="Particle color"
                   style="-fx-text-fill: white;"/>

            <ColorPicker fx:id="colorPicker"/>

            <Button fx:id="pauseButton"
                    text="Pause"
                    maxWidth="Infinity"
                    onAction="#togglePause"/>

            <Button text="Reset"
                    maxWidth="Infinity"
                    onAction="#reset"/>

        </VBox>
    </right>

</BorderPane>